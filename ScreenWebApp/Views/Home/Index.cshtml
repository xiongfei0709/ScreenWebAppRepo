﻿@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>急诊预检分诊</title>
    <!-- 引入 ECharts 和 jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/echarts.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            background: radial-gradient(circle at center, #093892, #060c26);
            font-family: 'Microsoft YaHei', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            position: relative;
        }

            /* 科技感网格纹理 */
            body::before {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: linear-gradient(rgba(100, 180, 255, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(100, 180, 255, 0.08) 1px, transparent 1px);
                background-size: 30px 30px;
                pointer-events: none;
                z-index: 0;
            }

            /* 动态光晕效果 */
            body::after {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 70% 20%, rgba(0, 150, 255, 0.08), transparent 70%);
                pointer-events: none;
                z-index: 0;
                animation: glowPulse 8s ease-in-out infinite;
            }

        @@keyframes glowPulse {
            0% {
                opacity: 0.3;
            }

            50% {
                opacity: 0.7;
            }

            100% {
                opacity: 0.3;
            }
        }

        .dashboard {
            height: 100%;
            display: flex;
            flex-direction: column;
            max-width: 1600px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
            padding: 0px 20px 30px 20px; /* 上 右 下 左 */
        }

        /* 顶部信息栏 - 使用 Grid 布局实现标题居中 */
        .info-bar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 20px;
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 12px 24px;
            margin-bottom: 20px;
            border: 1px solid rgba(64, 158, 255, 0.35);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(64, 158, 255, 0.1) inset;
            flex-shrink: 0;
        }

        .info-left .date-time {
            display: flex;
            flex-direction: column;
        }

        .info-left .date {
            font-size: 14px;
            color: #cce6ff;
            letter-spacing: 1px;
        }

        .info-left .time {
            font-size: 28px;
            font-weight: bold;
            color: #fff;
            line-height: 1.2;
            font-family: monospace;
            text-shadow: 0 0 10px #409eff;
        }

        /* 居中标题样式 */
        .info-center {
            font-size: 28px;
            font-weight: bold;
            color: #fff;
            text-shadow: 0 0 15px #409eff;
            letter-spacing: 2px;
            white-space: nowrap;
        }

        .info-middle {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: center;
            justify-content: flex-end;
        }

        .info-item {
            display: flex;
            align-items: baseline;
            gap: 6px;
            background: rgba(0, 0, 0, 0.5);
            padding: 4px 14px;
            border-radius: 40px;
            border: 1px solid rgba(64, 158, 255, 0.4);
        }

        .info-label {
            font-size: 12px;
            color: #b3d9ff;
        }

        .info-value {
            font-size: 20px;
            font-weight: bold;
            color: #fff;
        }

        .info-unit {
            font-size: 11px;
            color: #b3d9ff;
        }

        .status-normal {
            color: #67c23a;
            text-shadow: 0 0 5px #67c23a;
        }

        /* 主要内容区域（可滚动，但浏览器无滚动条） */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
        }

        .main-content {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
            /* 隐藏滚动条（Firefox） */
            scrollbar-width: none;
        }
            /* 隐藏滚动条（Chrome/Safari/Edge） */
            .main-content::-webkit-scrollbar {
                display: none;
            }

        /* 卡片样式 */
        .card {
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            padding: 16px 20px;
            transition: all 0.3s;
            border: 1px solid rgba(64, 158, 255, 0.25);
            margin-bottom: 10px;
        }

            .card:last-child {
                margin-bottom: 10px;
            }

            .card:hover {
                border-color: rgba(64, 158, 255, 0.7);
                box-shadow: 0 8px 32px rgba(64, 158, 255, 0.2);
                transform: translateY(-2px);
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: #e6f7ff;
            letter-spacing: 1px;
            position: relative;
            padding-left: 12px;
        }

            .card-title::before {
                content: "";
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 16px;
                background: #409eff;
                border-radius: 2px;
            }

        /* 按钮组 */
        .btn-group {
            display: flex;
            gap: 6px;
        }

        .btn-time {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            padding: 4px 12px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 12px;
            transition: 0.2s;
            color: #e6f7ff;
        }

            .btn-time.active {
                background: #409eff;
                color: white;
                box-shadow: 0 0 8px #409eff;
            }

            .btn-time:hover {
                background: rgba(64, 158, 255, 0.7);
            }

        /* 床位网格 */
        .bed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(85px, 1fr));
            gap: 10px;
            margin-top: 12px;
            max-height: 220px;
            overflow-y: auto;
            padding-right: 4px;
        }

            .bed-grid::-webkit-scrollbar {
                width: 3px;
                background: rgba(255,255,255,0.1);
                border-radius: 2px;
            }

            .bed-grid::-webkit-scrollbar-thumb {
                background: #409eff;
                border-radius: 2px;
            }

        .bed-item {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 6px 4px;
            text-align: center;
            font-size: 11px;
            border-left: 3px solid #67c23a;
            cursor: pointer;
            transition: 0.2s;
            color: #fff;
        }

            /* 床位等级颜色（5级） */
            .bed-item.level-1 {
                border-left-color: #f56c6c;
                background: rgba(245, 108, 108, 0.2);
            }

            .bed-item.level-2 {
                border-left-color: #e6a23c;
                background: rgba(230, 162, 60, 0.2);
            }

            .bed-item.level-3 {
                border-left-color: #f0ad4e;
                background: rgba(240, 173, 78, 0.2);
            }

            .bed-item.level-4 {
                border-left-color: #67c23a;
                background: rgba(103, 194, 58, 0.2);
            }

            .bed-item.level-5 {
                border-left-color: #409eff;
                background: rgba(64, 158, 255, 0.2);
            }

        .bed-level-badge {
            display: inline-block;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            border-radius: 50%;
            font-size: 10px;
            font-weight: bold;
            margin-right: 6px;
            color: white;
        }

        .level-1 .bed-level-badge {
            background: #f56c6c;
        }

        .level-2 .bed-level-badge {
            background: #e6a23c;
        }

        .level-3 .bed-level-badge {
            background: #f0ad4e;
        }

        .level-4 .bed-level-badge {
            background: #67c23a;
        }

        .level-5 .bed-level-badge {
            background: #409eff;
        }

        /* 等级图例 */
        .level-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 12px;
            padding: 6px 0;
            border-bottom: 1px solid rgba(64, 158, 255, 0.4);
        }

        .legend-item {
            display: inline-flex;
            align-items: center;
            font-size: 11px;
            color: #e6f7ff;
            padding: 2px 10px;
            border-radius: 30px;
            background: rgba(0, 0, 0, 0.4);
        }

            .legend-item::before {
                content: "";
                display: inline-block;
                width: 10px;
                height: 10px;
                border-radius: 2px;
                margin-right: 6px;
            }

            .legend-item.level-1::before {
                background: #f56c6c;
            }

            .legend-item.level-2::before {
                background: #e6a23c;
            }

            .legend-item.level-3::before {
                background: #f0ad4e;
            }

            .legend-item.level-4::before {
                background: #67c23a;
            }

            .legend-item.level-5::before {
                background: #409eff;
            }

        /* 布局网格 */
        .grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 5px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 5px;
        }

        .full-width {
            grid-column: span 2;
        }

        .chart-container {
            width: 100%;
            height: 280px;
        }

        /* 图表容器透明 */
        #chartTriage, #chartReg, #chartVisit, #chartRescue,
        #flowChart, #levelPie, #typeBar, #timeLine {
            background: transparent !important;
        }

        /* 底部滚动温馨提示 */
        .notice-bar {
            width: 100%;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            border-radius: 40px;
            margin-top: 20px;
            padding: 10px 0;
            border: 1px solid rgba(64, 158, 255, 0.4);
            flex-shrink: 0;
        }

        .notice-scroll {
            display: inline-block;
            white-space: nowrap;
            animation: scrollRightToLeft 20s linear infinite;
        }

        .notice-text {
            display: inline-block;
            font-size: 16px;
            color: #e6f7ff;
            letter-spacing: 1px;
            padding: 0 20px;
            text-shadow: 0 0 5px rgba(64, 158, 255, 0.5);
        }

        @@keyframes scrollRightToLeft {
            0% {
                transform: translateX(100%);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        .notice-bar:hover .notice-scroll {
            animation-play-state: paused;
        }

        /* 响应式 */
        @@media (max-width: 1200px) {
            .grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }

            .full-width {
                grid-column: span 1;
            }
        }

        @@media (max-width: 1000px) {
            .info-bar {
                grid-template-columns: 1fr;
                gap: 15px;
                text-align: center;
            }

            .info-left, .info-center, .info-middle {
                justify-self: center;
            }

            .info-middle {
                justify-content: center;
            }

            .info-center {
                font-size: 24px;
                order: 0;
            }

            .info-left {
                order: 1;
            }

            .info-middle {
                order: 2;
            }
        }

        @@media (max-width: 768px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <!-- 顶部信息栏：左侧日期时间，居中标题，右侧指标 -->
        <div class="info-bar">
            <div class="info-left">
                <div class="date-time">
                    <div class="date" id="currentDate">2024年8月15日</div>
                    <div class="time" id="currentTime">14:30:00</div>
                </div>
            </div>
            <div class="info-center">急诊预检分诊</div>
            <div class="info-middle">
