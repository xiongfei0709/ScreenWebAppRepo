﻿@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>急诊预检分诊</title>
    <!-- 引入 ECharts 和 jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/echarts.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            background: radial-gradient(circle at center, #093892, #060c26);
            font-family: 'Microsoft YaHei', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            position: relative;
        }

            /* 科技感网格纹理 */
            body::before {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: linear-gradient(rgba(100, 180, 255, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(100, 180, 255, 0.08) 1px, transparent 1px);
                background-size: 30px 30px;
                pointer-events: none;
                z-index: 0;
            }

            /* 动态光晕效果 */
            body::after {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 70% 20%, rgba(0, 150, 255, 0.08), transparent 70%);
                pointer-events: none;
                z-index: 0;
                animation: glowPulse 8s ease-in-out infinite;
            }

        @@keyframes glowPulse {
            0% {
                opacity: 0.3;
            }

            50% {
                opacity: 0.7;
            }

            100% {
                opacity: 0.3;
            }
        }

        .dashboard {
            height: 100%;
            display: flex;
            flex-direction: column;
            max-width: 1600px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
            padding: 0px 20px 30px 20px; /* 上 右 下 左 */
        }

        /* 顶部信息栏 - 使用 Grid 布局实现标题居中 */
        .info-bar {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 20px;
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 12px 24px;
            margin-bottom: 20px;
            border: 1px solid rgba(64, 158, 255, 0.35);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(64, 158, 255, 0.1) inset;
            flex-shrink: 0;
        }

        .info-left .date-time {
            display: flex;
            flex-direction: column;
        }

        .info-left .date {
            font-size: 14px;
            color: #cce6ff;
            letter-spacing: 1px;
        }

        .info-left .time {
            font-size: 28px;
            font-weight: bold;
            color: #fff;
            line-height: 1.2;
            font-family: monospace;
            text-shadow: 0 0 10px #409eff;
        }

        /* 居中标题样式 */
        .info-center {
            font-size: 28px;
            font-weight: bold;
            color: #fff;
            text-shadow: 0 0 15px #409eff;
            letter-spacing: 2px;
            white-space: nowrap;
        }

        .info-middle {
            display: grid;
            grid-template-columns: repeat(3, auto);
            gap: 20px;
            align-items: center;
            justify-self: end; /* 使整个容器在父网格中右对齐，保持原有布局 */
        }

        .info-item {
            display: flex;
            align-items: baseline;
            gap: 6px;
            background: rgba(0, 0, 0, 0.5);
            padding: 4px 14px;
            border-radius: 40px;
            border: 1px solid rgba(64, 158, 255, 0.4);
        }

        .info-label {
            font-size: 12px;
            color: #b3d9ff;
        }

        .info-value {
            font-size: 20px;
            font-weight: bold;
            color: #fff;
        }

        .info-unit {
            font-size: 11px;
            color: #b3d9ff;
        }

        .status-normal {
            color: #67c23a;
            text-shadow: 0 0 5px #67c23a;
        }

        .status-error {
            color: #ff0000;
            text-shadow: 0 0 5px #67c23a;
        }

        .status-warning {
            color: #ffd800;
            text-shadow: 0 0 5px #67c23a;
        }

        /* 主要内容区域（可滚动，但浏览器无滚动条） */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
        }

        .main-content {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
            /* 隐藏滚动条（Firefox） */
            scrollbar-width: none;
        }
            /* 隐藏滚动条（Chrome/Safari/Edge） */
            .main-content::-webkit-scrollbar {
                display: none;
            }

        /* 卡片样式 */
        .card {
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            padding: 16px 20px;
            transition: all 0.3s;
            border: 1px solid rgba(64, 158, 255, 0.25);
            margin-bottom: 10px;
        }

            .card:last-child {
                margin-bottom: 10px;
            }

            .card:hover {
                border-color: rgba(64, 158, 255, 0.7);
                box-shadow: 0 8px 32px rgba(64, 158, 255, 0.2);
                transform: translateY(-2px);
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: #e6f7ff;
            letter-spacing: 1px;
            position: relative;
            padding-left: 12px;
        }

            .card-title::before {
                content: "";
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 4px;
                height: 16px;
                background: #409eff;
                border-radius: 2px;
            }

        /* 按钮组 */
        .btn-group {
            display: flex;
            gap: 6px;
        }

        .btn-time {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            padding: 4px 12px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 12px;
            transition: 0.2s;
            color: #e6f7ff;
        }

            .btn-time.active {
                background: #409eff;
                color: white;
                box-shadow: 0 0 8px #409eff;
            }

            .btn-time:hover {
                background: rgba(64, 158, 255, 0.7);
            }

        /* 床位网格 */
        .bed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(85px, 1fr));
            gap: 10px;
            margin-top: 12px;
            max-height: 220px;
            overflow-y: auto;
            padding-right: 4px;
        }

            .bed-grid::-webkit-scrollbar {
                width: 3px;
                background: rgba(255,255,255,0.1);
                border-radius: 2px;
            }

            .bed-grid::-webkit-scrollbar-thumb {
                background: #409eff;
                border-radius: 2px;
            }

        .bed-item {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 6px 4px;
            text-align: center;
            font-size: 11px;
            border-left: 3px solid #67c23a;
            cursor: pointer;
            transition: 0.2s;
            color: #fff;
        }

            /* 床位等级颜色（5级） */
            .bed-item.level-1 {
                border-left-color: #f56c6c;
                background: rgba(245, 108, 108, 0.2);
            }

            .bed-item.level-2 {
                border-left-color: #e6a23c;
                background: rgba(230, 162, 60, 0.2);
            }

            .bed-item.level-3 {
                border-left-color: #f0ad4e;
                background: rgba(240, 173, 78, 0.2);
            }

            .bed-item.level-4 {
                border-left-color: #67c23a;
                background: rgba(103, 194, 58, 0.2);
            }

            .bed-item.level-5 {
                border-left-color: #409eff;
                background: rgba(64, 158, 255, 0.2);
            }

        .bed-level-badge {
            display: inline-block;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            border-radius: 50%;
            font-size: 10px;
            font-weight: bold;
            margin-right: 6px;
            color: white;
        }

        .level-1 .bed-level-badge {
            background: #f56c6c;
        }

        .level-2 .bed-level-badge {
            background: #e6a23c;
        }

        .level-3 .bed-level-badge {
            background: #f0ad4e;
        }

        .level-4 .bed-level-badge {
            background: #67c23a;
        }

        .level-5 .bed-level-badge {
            background: #409eff;
        }

        /* 等级图例 */
        .level-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 12px;
            padding: 6px 0;
            border-bottom: 1px solid rgba(64, 158, 255, 0.4);
        }

        .legend-item {
            display: inline-flex;
            align-items: center;
            font-size: 11px;
            color: #e6f7ff;
            padding: 2px 10px;
            border-radius: 30px;
            background: rgba(0, 0, 0, 0.4);
        }

            .legend-item::before {
                content: "";
                display: inline-block;
                width: 10px;
                height: 10px;
                border-radius: 2px;
                margin-right: 6px;
            }

            .legend-item.level-1::before {
                background: #f56c6c;
            }

            .legend-item.level-2::before {
                background: #e6a23c;
            }

            .legend-item.level-3::before {
                background: #f0ad4e;
            }

            .legend-item.level-4::before {
                background: #67c23a;
            }

            .legend-item.level-5::before {
                background: #409eff;
            }

        /* 布局网格 */
        .grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 5px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 5px;
        }

        .full-width {
            grid-column: span 2;
        }

        .chart-container {
            width: 100%;
            height: 280px;
        }

        /* 图表容器透明 */
        #chartTriage, #chartReg, #chartVisit, #chartRescue,
        #flowChart, #levelPie, #typeBar, #timeLine {
            background: transparent !important;
        }

        /* 底部滚动温馨提示 */
        .notice-bar {
            width: 100%;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            border-radius: 40px;
            margin-top: 20px;
            padding: 10px 0;
            border: 1px solid rgba(64, 158, 255, 0.4);
            flex-shrink: 0;
        }

        .notice-scroll {
            display: inline-block;
            white-space: nowrap;
            animation: scrollRightToLeft 20s linear infinite;
        }

        .notice-text {
            display: inline-block;
            font-size: 16px;
            color: #e6f7ff;
            letter-spacing: 1px;
            padding: 0 20px;
            text-shadow: 0 0 5px rgba(64, 158, 255, 0.5);
        }

        @@keyframes scrollRightToLeft {
            0% {
                transform: translateX(100%);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        .notice-bar:hover .notice-scroll {
            animation-play-state: paused;
        }

        /* 响应式 */
        @@media (max-width: 1200px) {
            .grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }

            .full-width {
                grid-column: span 1;
            }
        }

        @@media (max-width: 1000px) {
            .info-bar {
                grid-template-columns: 1fr;
                gap: 15px;
                text-align: center;
            }

            .info-left, .info-center, .info-middle {
                justify-self: center;
            }

            .info-middle {
                justify-content: center;
            }

            .info-center {
                font-size: 24px;
                order: 0;
            }

            .info-left {
                order: 1;
            }

            .info-middle {
                order: 2;
            }
        }

        @@media (max-width: 768px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        /* 全屏时图表容器样式 */
        /* 全屏时只设置背景和毛玻璃效果，不改变布局 */
        #chartTriage:fullscreen,
        #chartReg:fullscreen,
        #chartVisit:fullscreen,
        #chartRescue:fullscreen {
            background: radial-gradient(circle at center, #093892, #060c26) !important;
            backdrop-filter: blur(12px);
        }

        #chartTriage:-webkit-full-screen,
        #chartReg:-webkit-full-screen,
        #chartVisit:-webkit-full-screen,
        #chartRescue:-webkit-full-screen {
            background: radial-gradient(circle at center, #093892, #060c26) !important;
            backdrop-filter: blur(12px);
        }

        #chartTriage:-ms-fullscreen,
        #chartReg:-ms-fullscreen,
        #chartVisit:-ms-fullscreen,
        #chartRescue:-ms-fullscreen {
            background: radial-gradient(circle at center, #093892, #060c26) !important;
            backdrop-filter: blur(12px);
        }

    </style>
</head>
<body>
    <div class="dashboard">
        <!-- 顶部信息栏：左侧日期时间，居中标题，右侧指标 -->
        <div class="info-bar">
            <div class="info-left">
                <div class="date-time">
                    <div class="date" id="currentDate">1997年01月01日</div>
                    <div class="time" id="currentTime">00:00:01</div>
                </div>
            </div>
            <div class="info-center">急诊预检分诊</div>
            <div class="info-middle">
                <div class="info-item">
                    <span class="info-label">急诊饱和度</span>
                    <span class="info-value" id="saturationValue">75%</span>
                </div>
                <div class="info-item">
                    <span class="info-label">今日就诊人数</span>
                    <span class="info-value" id="todayVisits">120</span>
                    <span class="info-unit">人</span>
                </div>
                <div class="info-item">
                    <span class="info-label">系统状态</span>
                    <span class="info-value status-normal" id="systemStatus">正常</span>
                </div>
                <div class="info-item">
                    <span class="info-label">留抢人数</span>
                    <span class="info-value" id="retentionCount">15</span>
                    <span class="info-unit">人</span>
                </div>
                <div class="info-item">
                    <span class="info-label">绿通人数</span>
                    <span class="info-value" id="greenPassCount">5</span>
                    <span class="info-unit">人</span>
                </div>
            </div>
        </div>

        <!-- 主要内容区域 -->
        <div class="main-content">
            <!-- 第一行：四个折线图卡片 -->
            <div class="grid-4" id="kpiCards"></div>

            <!-- 第二行：床位状态 -->
            <div class="grid-2">
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">🏥 急诊抢救室床位状态</span>
                    </div>
                    <div class="level-legend">
                        <span class="legend-item level-1">1级 危重</span>
                        <span class="legend-item level-2">2级 重症</span>
                        <span class="legend-item level-3">3级 一般</span>
                        <span class="legend-item level-4">4级 轻症</span>
                        <span class="legend-item level-5">空床</span>
                    </div>
                    <div class="bed-grid" id="rescueBeds"></div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <span class="card-title">🏥 急诊留观室床位状态</span>
                    </div>
                    <div class="level-legend">
                        <span class="legend-item level-1">1级 危重</span>
                        <span class="legend-item level-2">2级 重症</span>
                        <span class="legend-item level-3">3级 一般</span>
                        <span class="legend-item level-4">4级 轻症</span>
                        <span class="legend-item level-5">空床</span>
                    </div>
                    <div class="bed-grid" id="obsBeds"></div>
                </div>
            </div>
        </div>

        <!-- 底部温馨提示 -->
        <div class="notice-bar">
            <div class="notice-scroll">
                <span class="notice-text">🏥 温馨提示：请保持急救通道畅通，危重患者优先就诊。如需帮助请联系急诊分诊台。感谢您的配合！</span>
            </div>
        </div>
    </div>

    <script>

        /**
 * 为图表容器启用双击全屏功能
 * @@param {string} chartId 容器ID
 * @@param {Object} chartInstance ECharts实例
 */
        function enableFullscreenOnDoubleClick(chartId, chartInstance) {
            var container = document.getElementById(chartId);
            if (!container) return;

            container.addEventListener('dblclick', function () {
                if (container.requestFullscreen) container.requestFullscreen();
                else if (container.webkitRequestFullscreen) container.webkitRequestFullscreen();
                else if (container.msRequestFullscreen) container.msRequestFullscreen();
            });

            // 获取所有图表实例的全局引用（假设已在 renderKPIs 中定义）
            var allCharts = [chartTriage, chartReg, chartVisit, chartRescue];

            // 批量调整所有图表尺寸
            function resizeAllCharts() {
                allCharts.forEach(function (chart) {
                    if (chart && typeof chart.resize === 'function') {
                        chart.resize();
                    }
                });
                // 可选：手动触发窗口 resize 事件，帮助其他依赖组件
                if (window.dispatchEvent) {
                    window.dispatchEvent(new Event('resize'));
                }
            }

            var handleFullscreenChange = function () {
                // 延迟两次确保浏览器布局完全稳定
                setTimeout(resizeAllCharts, 50);
                setTimeout(resizeAllCharts, 150);
            };

            document.addEventListener('fullscreenchange', handleFullscreenChange);
            document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
        }

        let chartTriage, chartReg, chartVisit, chartRescue;

        function renderKPIs() {
            const kpiHtml = `
                        <div class="card">
                            <div class="card-header">
                                <span class="card-title">🏷️ 急诊分诊人次</span>
                                <div class="btn-group" data-chart="triage">
                                    <button class="btn-time" data-period="day">日</button>
                                    <button class="btn-time" data-period="week">周</button>
                                    <button class="btn-time" data-period="month">月</button>
                                    <button class="btn-time" data-period="year">年</button>
                                </div>
                            </div>
                            <div id="chartTriage" style="height:200px; width:100%;"></div>
                        </div>
                        <div class="card">
                            <div class="card-header">
                                <span class="card-title">📋 急诊挂号人次</span>
                                <div class="btn-group" data-chart="registration">
                                    <button class="btn-time" data-period="day">日</button>
                                    <button class="btn-time" data-period="week">周</button>
                                    <button class="btn-time" data-period="month">月</button>
                                    <button class="btn-time" data-period="year">年</button>
                                </div>
                            </div>
                            <div id="chartReg" style="height:200px; width:100%;"></div>
                        </div>
                        <div class="card">
                            <div class="card-header">
                                <span class="card-title">🚑 急诊就诊人次</span>
                                <div class="btn-group" data-chart="visit">
                                    <button class="btn-time" data-period="day">日</button>
                                    <button class="btn-time" data-period="week">周</button>
                                    <button class="btn-time" data-period="month">月</button>
                                    <button class="btn-time" data-period="year">年</button>
                                </div>
                            </div>
                            <div id="chartVisit" style="height:200px; width:100%;"></div>
                        </div>
                        <div class="card">
                            <div class="card-header">
                                <span class="card-title">⚠️ 急诊绿通人次</span>
                                <div class="btn-group" data-chart="rescue">
                                    <button class="btn-time" data-period="day">日</button>
                                    <button class="btn-time" data-period="week">周</button>
                                    <button class="btn-time" data-period="month">月</button>
                                    <button class="btn-time" data-period="year">年</button>
                                </div>
                            </div>
                            <div id="chartRescue" style="height:200px; width:100%;"></div>
                        </div>
                    `;
            $('#kpiCards').html(kpiHtml);

            chartTriage = echarts.init(document.getElementById('chartTriage'));
            enableFullscreenOnDoubleClick('chartTriage', chartTriage);

            chartReg = echarts.init(document.getElementById('chartReg'));
            enableFullscreenOnDoubleClick('chartReg', chartReg);

            chartVisit = echarts.init(document.getElementById('chartVisit'));
            enableFullscreenOnDoubleClick('chartVisit', chartVisit);

            chartRescue = echarts.init(document.getElementById('chartRescue'));
            enableFullscreenOnDoubleClick('chartRescue', chartRescue);            

            updateKpiChart('triage', 'day');
            updateKpiChart('registration', 'day');
            updateKpiChart('visit', 'day');
            updateKpiChart('rescue', 'day');

            $('.btn-group[data-chart]').each(function () {
                const chartType = $(this).data('chart');
                $(this).find('.btn-time').click(function (e) {
                    e.stopPropagation();
                    const period = $(this).data('period');
                    $(this).siblings().removeClass('active');
                    $(this).addClass('active');
                    updateKpiChart(chartType, period);
                });
            });
        }

        //加载顶部信息
        function LoadTopData() {
            $.ajax({
                url: '/api/dashboard/info',
                type: 'GET',
                success: function (data) {
                    $('#saturationValue').text(data.Saturation + '%');
                    $('#systemStatus').text(data.SystemStatus);
                    $('#todayVisits').text(data.TodayVisits);
                    $('#retentionCount').text(data.RetentionCount);
                    $('#greenPassCount').text(data.GreenPassCount);
                    if (data.SystemStatus === '正常') {
                        $('#systemStatus').removeClass('status-warning status-error').addClass('status-normal');
                    } else if (data.SystemStatus === '警告') {
                        $('#systemStatus').removeClass('status-normal status-error').addClass('status-warning');
                    } else {
                        $('#systemStatus').removeClass('status-normal status-warning').addClass('status-error');
                    }
                },
                error: function () {
                    console.error('加载顶部信息失败');
                }
            });
        }

        function updateKpiChart(type, period) {
            $.ajax({
                url: '/api/dashboard/trend',
                data: { type: type, period: period },
                type: 'GET',
                success: function (data) {
                    var chartMap = {
                        triage: chartTriage,
                        registration: chartReg,
                        visit: chartVisit,
                        rescue: chartRescue
                    };
                    var chart = chartMap[type];
                    if (!chart) return;

                    chart.setOption({
                        tooltip: { trigger: 'axis' },
                        xAxis: { type: 'category', data: data.Categories, name: getPeriodName(period) },
                        yAxis: { type: 'value', name: '人次' },
                        series: [{
                            type: 'line',
                            data: data.Values,
                            smooth: true,
                            lineStyle: { color: '#409eff', width: 2 },
                            areaStyle: { opacity: 0.1 },
                            symbol: 'circle',
                            symbolSize: 6
                        }],
                        grid: { containLabel: true, left: 40, right: 20, top: 30, bottom: 20 }
                    });
                },
                error: function () {
                    console.error('加载相关人次数据失败', type, period);
                }
            });
        }

        function getPeriodName(period) {
            switch (period) {
                case 'day': return '时段';
                case 'week': return '星期';
                case 'month': return '周次';
                case 'year': return '月份';
                default: return '';
            }
        }

        function renderBeds() {
            $.ajax({
                url: '/api/dashboard/beds',
                type: 'GET',
                success: function (data) {
                    var rescueHtml = '';
                    data.RescueBeds.forEach(function (bed) {
                        rescueHtml += `<div class="bed-item level-${bed.Level}">
                                        <span class="bed-level-badge">${bed.Level}</span>
                                        ${bed.Name}
                                   </div>`;
                    });
                    $('#rescueBeds').html(rescueHtml);

                    var obsHtml = '';
                    data.ObservationBeds.forEach(function (bed) {
                        obsHtml += `<div class="bed-item level-${bed.Level}">
                                    <span class="bed-level-badge">${bed.Level}</span>
                                    ${bed.Name}
                                </div>`;
                    });
                    $('#obsBeds').html(obsHtml);
                },
                error: function () {
                    console.error('加载床位数据失败');
                }
            });
        }

        // 数据初始化加载
        //function Init() {
        //    $.ajax({
        //        url: '/api/dashboard/init',
        //        type: 'GET',
        //        success: function (data) {
        //            if (data.SystemStatus === '正常') {
        //                $('#systemStatus').removeClass('status-warning status-error').addClass('status-normal');
        //            } else if (data.SystemStatus === '警告') {
