        //                $('#systemStatus').removeClass('status-normal status-warning').addClass('status-error');
        //            }
        //        },
        //        error: function () {
        //            console.error('数据初始化加载失败');
        //        }
        //    });
        //}

        // 加载底部温馨提示
        function LoadBottomInfo() {
            $.ajax({
                url: '/api/dashboard/notice',
                type: 'GET',
                success: function (data) {
                    $('.notice-text').text(data.Message);
                },
                error: function () {
                    console.error('加载温馨提示失败，使用默认文本');
                    // 可选：降级方案，保持原有静态文本
                    // 如果希望降级，可以在这里设置默认文本，但原有静态文本已存在，所以不需要额外操作
                }
            });
        }

        function updateDateTime() {
            const now = new Date();
            $('#currentDate').text(`${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`);
            $('#currentTime').text(`${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`);
        }

        //动态刷新业务数据
        let autoRefreshTimer1 = null;
        let autoRefreshTimer2 = null;
        function startAutoRefresh(intervalSeconds = 30) {
            if (autoRefreshTimer2) clearInterval(autoRefreshTimer2);
            autoRefreshTimer2 = setInterval(function () {
                // 刷新顶部信息
                $.ajax({ url: '/api/dashboard/info', success: LoadTopData });
                // 刷新床位
                $.ajax({ url: '/api/dashboard/beds', success: renderBeds });
                // 刷新当前显示的图表（保留当前激活的周期）
                $('.btn-group[data-chart]').each(function () {
                    var chartType = $(this).data('chart');
                    var activePeriod = $(this).find('.btn-time.active').data('period') || 'day';
                    updateKpiChart(chartType, activePeriod);
                });
            }, intervalSeconds * 1000);
        }

        $(function () {
            LoadTopData();
            renderKPIs();
            $('.btn-time[data-period="day"]').addClass('active');
            renderBeds();
            LoadBottomInfo();

            // 页面加载后启动定时器
            if (autoRefreshTimer1) clearInterval(autoRefreshTimer1);
            autoRefreshTimer1 = setInterval(updateDateTime, 1000);
            startAutoRefresh(3);

            // 页面关闭前清除定时器
            $(window).on('beforeunload', function () {
                if (autoRefreshTimer1) {
                    clearInterval(autoRefreshTimer1);
                }
                if (autoRefreshTimer2) {
                    clearInterval(autoRefreshTimer2);
                }
            });
        });
    </script>
</body>
</html>